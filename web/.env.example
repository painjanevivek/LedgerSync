# LedgerSync frontend and BFF environment-variable checklist.
#
# Vercel project settings:
# - Root Directory: web
# - Framework Preset: Next.js
# - Configure Production and Preview values separately in Vercel.
#
# This tracked file contains names and safe placeholders only. Do not commit real
# credentials. None of these variables should use the NEXT_PUBLIC_ prefix because
# they are read by server-side authentication and BFF code.

# Runtime identity and public browser origin
LEDGERSYNC_DEPLOYMENT_ENV=production
LEDGERSYNC_PUBLIC_ORIGIN=https://replace-with-frontend-domain.example
LEDGERSYNC_COOKIE_SECURE=true

# Browser session signing (secret; generate a unique high-entropy value per scope)
LEDGERSYNC_WEB_SESSION_SECRET=

# Frontend-to-backend BFF assertion signing
# The active secret and key ID must match the backend project's active values.
LEDGERSYNC_BFF_ASSERTION_SECRET=
LEDGERSYNC_BFF_ASSERTION_KEY_ID=current
LEDGERSYNC_BFF_ASSERTION_ISSUER=ledgersync-bff
LEDGERSYNC_BFF_ASSERTION_AUDIENCE=ledgersync-private-api

# Optional key-rotation overlap. Add these only while rotating assertion keys.
# LEDGERSYNC_BFF_ASSERTION_PREVIOUS_SECRET=
# LEDGERSYNC_BFF_ASSERTION_PREVIOUS_KEY_ID=previous

# User sign-in through an OpenID Connect provider
LEDGERSYNC_OIDC_ISSUER_URL=
LEDGERSYNC_OIDC_CLIENT_ID=
LEDGERSYNC_OIDC_CLIENT_SECRET=
LEDGERSYNC_OIDC_REDIRECT_URI=https://replace-with-frontend-domain.example/api/auth/callback

# Optional JSON permissions map used only when the configured identity provider
# does not supply the required authorization claims.
# LEDGERSYNC_OIDC_SUBJECT_PERMISSIONS={}

# Private LedgerSync API endpoint used by server-side BFF routes
LEDGERSYNC_PRIVATE_API_URL=https://replace-with-backend-domain.example

# IMPORTANT: the current production credential policy intentionally rejects a
# static LEDGERSYNC_PRIVATE_API_TOKEN and requires a managed token file. Vercel's
# read-only serverless filesystem does not provide the existing renewal sidecar.
# Do not add either token variable to Production until the planned Vercel workload
# identity/managed-credential adapter is implemented. See deploy/vercel/README.md.
# LEDGERSYNC_PRIVATE_API_TOKEN=
# LEDGERSYNC_PRIVATE_API_TOKEN_FILE=

# Local-only variables intentionally excluded from Vercel:
# LEDGERSYNC_LOCAL_LOGIN_ENABLED, LEDGERSYNC_LOCAL_SUBJECT_ID,
# LEDGERSYNC_LOCAL_TENANT_ID, and LEDGERSYNC_DEVELOPMENT_API_TOKEN.
