{
  "name": "ledgersync-web",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0 || >=20.19.0 <21.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test tests/**/*.test.ts",
    "test:e2e": "playwright test --grep-invert @performance",
    "test:e2e:real-stack": "playwright test --config playwright.real-stack.config.ts",
    "test:e2e:performance": "playwright test --grep @performance --workers=1",
    "test:visual": "playwright test tests/e2e/visual-regression.spec.ts",
    "test:visual:update": "playwright test tests/e2e/visual-regression.spec.ts --update-snapshots",
    "test:performance": "node scripts/check-performance-budgets.mjs",
    "generate:developer-artifacts": "node ../scripts/generate-developer-artifacts.mjs",
    "check:developer-artifacts": "node ../scripts/generate-developer-artifacts.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@upstash/redis": "^1.38.4",
    "jose": "^5.10.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@redocly/cli": "2.51.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0",
    "yaml": "1.10.3"
  }
}
