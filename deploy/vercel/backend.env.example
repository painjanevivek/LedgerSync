# LedgerSync backend environment-variable checklist for a future Vercel project.
#
# STATUS: planning template, not a deployable backend configuration. The current
# Go API starts a long-running HTTP server and the worker runs continuously. Both
# need Vercel Function/Workflow/Cron adapters before this project can run correctly
# on Vercel. Never place real credentials in this tracked file.

# Runtime
LEDGERSYNC_ENV=production
LEDGERSYNC_PILOT_CURRENCY=INR

# Managed data services. Use provider-issued TLS URLs; do not set POSTGRES_PASSWORD
# separately when the password is already embedded in the managed connection URL.
LEDGERSYNC_DATABASE_URL=
LEDGERSYNC_REDIS_ADDR=

# API protection and capacity controls
LEDGERSYNC_READ_RATE_LIMIT_PER_MINUTE=6000
LEDGERSYNC_WRITE_RATE_LIMIT_PER_MINUTE=1800
LEDGERSYNC_WRITE_CAPACITY_PER_SECOND=30
LEDGERSYNC_REDIS_STREAM_MAX_LENGTH=5000000

# Consistency-token signing
LEDGERSYNC_CONSISTENCY_SIGNING_KEY=
LEDGERSYNC_CONSISTENCY_SIGNING_KEY_ID=current

# Backend session/authentication signing
LEDGERSYNC_SESSION_SECRET=

# BFF assertion verification. These values must match the frontend project.
LEDGERSYNC_BFF_ASSERTION_SECRET=
LEDGERSYNC_BFF_ASSERTION_KEY_ID=current
LEDGERSYNC_BFF_ASSERTION_ISSUER=ledgersync-bff
LEDGERSYNC_BFF_ASSERTION_AUDIENCE=ledgersync-private-api

# Optional key-rotation overlap. Add these only while rotating assertion keys.
# LEDGERSYNC_BFF_ASSERTION_PREVIOUS_SECRET=
# LEDGERSYNC_BFF_ASSERTION_PREVIOUS_KEY_ID=previous

# API-side OpenID Connect validation and tenant mapping
LEDGERSYNC_OIDC_ISSUER_URL=
LEDGERSYNC_OIDC_RESOURCE_AUDIENCE=
LEDGERSYNC_OIDC_CLIENT_TENANT_MAP=

# Optional webhook key-manager integration
# AWS_REGION=
# LEDGERSYNC_WEBHOOK_SIGNING_KEYS_JSON=

# Optional telemetry. Enable only after providing a reachable OTLP endpoint.
LEDGERSYNC_TELEMETRY_ENABLED=false
LEDGERSYNC_TELEMETRY_SERVICE_NAME=ledgersync-api
# LEDGERSYNC_OTLP_HTTP_ENDPOINT=

# Long-running server/process settings intentionally excluded from this Vercel
# template: LEDGERSYNC_HTTP_ADDR, LEDGERSYNC_STARTUP_*, LEDGERSYNC_SHUTDOWN_TIMEOUT,
# and LEDGERSYNC_HTTP_*_TIMEOUT. A serverless adapter must own those concerns.
#
# Development/local identity variables intentionally excluded from Production:
# LEDGERSYNC_DEVELOPMENT_*, LEDGERSYNC_LOCAL_*, and POSTGRES_PASSWORD.
