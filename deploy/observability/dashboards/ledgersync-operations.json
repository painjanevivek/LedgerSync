{
  "uid": "ledgersync-operations",
  "title": "LedgerSync Financial Operations",
  "schemaVersion": 39,
  "refresh": "30s",
  "tags": ["ledgersync", "financial-safety"],
  "panels": [
    {"id": 1, "title": "Transfer outcomes / minute", "type": "timeseries", "targets": [{"expr": "sum(rate(ledgersync_transfer_outcomes_total[1m])) by (status, replayed)"}]},
    {"id": 2, "title": "HTTP p95 latency", "type": "timeseries", "targets": [{"expr": "histogram_quantile(0.95, sum(rate(ledgersync_boundary_duration_milliseconds_bucket{boundary=\"http\"}[5m])) by (le))"}]},
    {"id": 3, "title": "PostgreSQL boundary failures", "type": "stat", "targets": [{"expr": "sum(rate(ledgersync_boundary_operations_total{boundary=\"postgres\",outcome=\"error\"}[5m]))"}]},
    {"id": 4, "title": "Redis/cache boundary failures", "type": "stat", "targets": [{"expr": "sum(rate(ledgersync_boundary_operations_total{boundary=~\"cache|event\",outcome=\"error\"}[5m]))"}]},
    {"id": 5, "title": "Outbox p99 event age", "type": "timeseries", "targets": [{"expr": "histogram_quantile(0.99, sum(rate(ledgersync_outbox_event_age_seconds_bucket[5m])) by (le))"}]},
    {"id": 6, "title": "RYEW violations", "type": "stat", "targets": [{"expr": "sum(increase(ledgersync_ryew_violations_total[24h]))"}]},
    {"id": 7, "title": "Reconciliation runs", "type": "timeseries", "targets": [{"expr": "sum(increase(ledgersync_reconciliation_runs_total[1h])) by (status)"}]},
    {"id": 8, "title": "Worker dependency outcomes", "type": "timeseries", "targets": [{"expr": "sum(rate(ledgersync_boundary_operations_total{boundary=\"worker\"}[5m])) by (operation, outcome)"}]},
    {"id": 9, "title": "Worker heartbeat age", "type": "timeseries", "targets": [{"expr": "time() - ledgersync_worker_heartbeat_unix_seconds"}]},
    {"id": 10, "title": "Active worker progress age", "type": "timeseries", "targets": [{"expr": "ledgersync_worker_progress_age_seconds and on(queue) (ledgersync_worker_active == 1)"}]},
    {"id": 11, "title": "Webhook key-cache capacity evictions", "type": "timeseries", "targets": [{"expr": "sum(rate(ledgersync_webhook_key_cache_evictions_total{reason=\"capacity\"}[5m]))"}]},
    {"id": 12, "title": "Webhook key-cache p99 lock wait", "type": "timeseries", "targets": [{"expr": "histogram_quantile(0.99, sum(rate(ledgersync_webhook_key_cache_lock_wait_milliseconds_bucket[5m])) by (le))"}]},
    {"id": 13, "title": "Committed response metadata unavailable", "type": "timeseries", "targets": [{"expr": "sum(rate(ledgersync_committed_response_metadata_unavailable_total[5m])) by (command_kind)"}]},
    {"id": 14, "title": "Committed response write failures", "type": "timeseries", "targets": [{"expr": "sum(rate(ledgersync_committed_response_write_failures_total[5m])) by (command_kind)"}]}
  ]
}
