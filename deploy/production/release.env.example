# Private image and environment-file inputs. No real secret belongs here.
LEDGERSYNC_RELEASE_API_IMAGE=
LEDGERSYNC_RELEASE_WORKER_IMAGE=
LEDGERSYNC_RELEASE_WEB_IMAGE=
LEDGERSYNC_RELEASE_MIGRATION_IMAGE=
LEDGERSYNC_PRODUCTION_API_ENV=
LEDGERSYNC_PRODUCTION_WORKER_ENV=
LEDGERSYNC_PRODUCTION_WEB_ENV=
LEDGERSYNC_PRODUCTION_MIGRATION_ENV=
# Supply repository@sha256:<64 hex> values after provider/registry selection.
# Use independent env files with only the values each workload needs.
# API/worker/migration: derive supported names from deploy/vercel/backend.env.example.
# Browser BFF: derive names from web/.env.example. Cookie security stays enabled.
# Migration-only PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD and PGSSLMODE
# let psql use its environment. Use sslmode=verify-full and a trusted root.
# The migration image is the database-tooling target, never an API workload login.
