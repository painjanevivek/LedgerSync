# Production builds receive only the reviewed source roots below.
# Keep private state and documentation/media output outside the build context.
*
!go.mod
!go.sum
!go.work
!go.work.sum
!cmd/
!cmd/**
!contracts/
!contracts/**
!internal/
!internal/**
!migrations/
!migrations/**
!deploy/
!deploy/postgres/
!deploy/postgres/**
!web/
!web/**

# Re-exclude local state inside otherwise allowed source directories.
**/node_modules/
**/.next/
**/.env*
**/*.env
**/.git/
**/.agents/
**/.codex/
**/.aws/
**/.codebase-memory/
**/AGENTS.md
**/SKILL.md
**/playwright-report*/
**/test-results/
**/coverage/
**/*.log
**/tsconfig.tsbuildinfo
web/chunks/
web/*/_buildManifest.js
web/*/_clientMiddlewareManifest.js
web/*/_ssgManifest.js
