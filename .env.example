# Development only. Do not place production secrets in this file.
LEDGERSYNC_ENV=development
LEDGERSYNC_HTTP_ADDR=:8080
LEDGERSYNC_SHUTDOWN_TIMEOUT=10s
LEDGERSYNC_HTTP_READ_HEADER_TIMEOUT=3s
LEDGERSYNC_HTTP_READ_TIMEOUT=10s
LEDGERSYNC_HTTP_WRITE_TIMEOUT=15s
LEDGERSYNC_HTTP_IDLE_TIMEOUT=60s
LEDGERSYNC_HTTP_MAX_HEADER_BYTES=32768
LEDGERSYNC_PILOT_CURRENCY=INR
LEDGERSYNC_READ_RATE_LIMIT_PER_MINUTE=120
LEDGERSYNC_WRITE_RATE_LIMIT_PER_MINUTE=30
LEDGERSYNC_REDIS_STREAM_MAX_LENGTH=5000000
LEDGERSYNC_DATABASE_URL=postgres://ledgersync:replace-me@postgres:5432/ledgersync?sslmode=disable
LEDGERSYNC_REDIS_ADDR=redis:6379
# Minimum 32-byte independent HMAC secret for short-lived balance freshness requirements.
LEDGERSYNC_CONSISTENCY_SIGNING_KEY=replace-with-a-third-long-random-development-secret
LEDGERSYNC_CONSISTENCY_SIGNING_KEY_ID=current
LEDGERSYNC_SESSION_SECRET=replace-with-a-long-random-development-secret
# BFF-only signing key; generate independently from the API secret.
LEDGERSYNC_WEB_SESSION_SECRET=replace-with-a-different-long-random-development-secret
# The externally visible BFF origin is mandatory in production for CSRF checks.
LEDGERSYNC_PUBLIC_ORIGIN=http://localhost:3000
# Local HTTP only. Production ignores false and always emits Secure cookies.
LEDGERSYNC_COOKIE_SECURE=false
# Shared only by the BFF and private API to attest the OIDC session's actor
# context. Use an independent managed secret in every production environment.
LEDGERSYNC_BFF_ASSERTION_SECRET=replace-with-another-long-random-development-secret
LEDGERSYNC_BFF_ASSERTION_KEY_ID=current
LEDGERSYNC_BFF_ASSERTION_ISSUER=ledgersync-bff
LEDGERSYNC_BFF_ASSERTION_AUDIENCE=ledgersync-private-api
# Optional previous key during a bounded rotation overlap.
LEDGERSYNC_BFF_ASSERTION_PREVIOUS_SECRET=
LEDGERSYNC_BFF_ASSERTION_PREVIOUS_KEY_ID=
LEDGERSYNC_OIDC_ISSUER_URL=
# Required for production Cognito access-token resource binding.
LEDGERSYNC_OIDC_RESOURCE_AUDIENCE=
# JSON object mapping approved Cognito app client IDs to tenant IDs. Client IDs
# are configuration, not secrets; client secrets remain in the managed store.
LEDGERSYNC_OIDC_CLIENT_TENANT_MAP=
LEDGERSYNC_OIDC_CLIENT_ID=
LEDGERSYNC_OIDC_CLIENT_SECRET=
LEDGERSYNC_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
# JSON object mapping invited Cognito subject IDs to server-owned tenant, role,
# and scope grants for the operator console. Never derive tenant authority from
# browser input or an unrestricted custom token claim.
LEDGERSYNC_OIDC_SUBJECT_PERMISSIONS=
# Explicitly local-only identity used only while OIDC integration is unfinished.
# Leave blank in shared environments; no financial HTTP route will be mounted.
LEDGERSYNC_DEVELOPMENT_SUBJECT_ID=
LEDGERSYNC_DEVELOPMENT_TENANT_ID=
# BFF-to-private-API settings. Production must inject a short-lived workload
# identity from a managed secret store; do not put a real value in an .env file.
LEDGERSYNC_PRIVATE_API_URL=http://api:8080
# Development only; production refuses a static token.
LEDGERSYNC_PRIVATE_API_TOKEN=
# Production workload agent writes and renews a short-lived token atomically.
LEDGERSYNC_PRIVATE_API_TOKEN_FILE=
# Shared environments must send traces and bounded metrics to a private collector.
LEDGERSYNC_TELEMETRY_ENABLED=false
LEDGERSYNC_TELEMETRY_SERVICE_NAME=ledgersync-api
LEDGERSYNC_OTLP_HTTP_ENDPOINT=
