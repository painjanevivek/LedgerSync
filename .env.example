# Development only. Do not place production secrets in this file.
LEDGERSYNC_ENV=development
LEDGERSYNC_HTTP_ADDR=:8080
LEDGERSYNC_SHUTDOWN_TIMEOUT=10s
LEDGERSYNC_DATABASE_URL=postgres://ledgersync:replace-me@postgres:5432/ledgersync?sslmode=disable
LEDGERSYNC_REDIS_ADDR=redis:6379
# Minimum 32-byte independent HMAC secret for short-lived balance freshness requirements.
LEDGERSYNC_CONSISTENCY_SIGNING_KEY=replace-with-a-third-long-random-development-secret
LEDGERSYNC_CONSISTENCY_SIGNING_KEY_ID=current
LEDGERSYNC_SESSION_SECRET=replace-with-a-long-random-development-secret
# BFF-only signing key; generate independently from the API secret.
LEDGERSYNC_WEB_SESSION_SECRET=replace-with-a-different-long-random-development-secret
# Shared only by the BFF and private API to attest the OIDC session's actor
# context. Use an independent managed secret in every production environment.
LEDGERSYNC_BFF_ASSERTION_SECRET=replace-with-another-long-random-development-secret
# Transfer mutation limits; production uses an atomic shared Redis limiter.
LEDGERSYNC_TRANSFER_RATE_LIMIT=10
LEDGERSYNC_OIDC_ISSUER_URL=
LEDGERSYNC_OIDC_AUDIENCE=ledgersync
# Explicitly local-only identity used only while OIDC integration is unfinished.
# Leave blank in shared environments; no financial HTTP route will be mounted.
LEDGERSYNC_DEVELOPMENT_SUBJECT_ID=
LEDGERSYNC_DEVELOPMENT_TENANT_ID=
# BFF-to-private-API settings. Production must inject a short-lived workload
# identity from a managed secret store; do not put a real value in an .env file.
LEDGERSYNC_PRIVATE_API_URL=http://api:8080
LEDGERSYNC_PRIVATE_API_TOKEN=
