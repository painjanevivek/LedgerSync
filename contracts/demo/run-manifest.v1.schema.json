{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ledgersync:demo-run:v1",
  "title": "LedgerSync demonstration run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "run_id",
    "started_at",
    "completed_at",
    "source",
    "images",
    "migration",
    "api_contract_version",
    "isolated_project",
    "limits",
    "scenarios",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "ledgersync-demo-run/v1"
    },
    "purpose": {
      "enum": [
        "contract-fixture",
        "run-evidence"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "manifest_sha256",
        "dirty"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "digest"
        ],
        "properties": {
          "service": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "maxItems": 20,
      "minItems": 1
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest",
        "count",
        "manifest_sha256"
      ],
      "properties": {
        "latest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "api_contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "isolated_project": {
      "type": "string",
      "pattern": "^ledgersync-acceptance-[0-9]{14}-[a-f0-9]{8}$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_seconds",
        "concurrency",
        "operations"
      ],
      "properties": {
        "duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "operations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "checks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "incomplete",
              "skipped"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "not-applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "enum": [
                          "failed",
                          "not-applicable"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "reason"
                    ]
                  }
                }
              ]
            },
            "maxItems": 100,
            "minItems": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "failed",
                    "incomplete",
                    "skipped"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        ]
      },
      "maxItems": 100,
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_./-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1073741824
          }
        }
      },
      "maxItems": 200,
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 50,
      "minItems": 1
    }
  }
}
